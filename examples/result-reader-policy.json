{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET",
      "Condition": {"StringLike": {"s3:prefix": ["results/realtime/REPLACE_PRINCIPAL_HASH/*"]}}
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::REPLACE_BUCKET/results/realtime/REPLACE_PRINCIPAL_HASH/*",
        "arn:aws:s3:::REPLACE_BUCKET/analysis-runs/REPLACE_PRINCIPAL_HASH/*"
      ]
    }
  ]
}
