# Production: set independently generated application keys in secure deployment settings.
# No default signing key and no plaintext credential fallback.
SECRET_KEY=replace-with-generated-application-signing-key-at-least-32-characters
FERNET_KEY=replace-with-a-generated-fernet-key
DATABASE_URL=sqlite:///./ueba_system.db
# Never commit real AWS keys. Local demo creates only synthetic AWS credentials in Moto.
